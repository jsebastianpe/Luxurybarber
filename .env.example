# Copia este archivo como .env y ajusta los valores
DJANGO_SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

BARBERIA_NOMBRE=Navaja & Cuero
BARBERIA_DIRECCION=Cra. 14 # 20-35, Armenia, Quindío
BARBERIA_TELEFONO=+57 300 000 0000
SITIO_URL=http://127.0.0.1:8000

# 1 = Tailwind por CDN (prototipar sin compilar). 0 = CSS compilado en static/css/tailwind.css
TAILWIND_CDN=0

# Mensajes: consola (desarrollo) o whatsapp (WhatsApp Cloud API de Meta). Guía: docs/WHATSAPP.md
MENSAJES_BACKEND=consola
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_WABA_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APPSECRET_PROOF=0
WHATSAPP_API_VERSION=v25.0
WHATSAPP_IDIOMA=es
WHATSAPP_PLANTILLA_OTP=codigo_verificacion
WHATSAPP_PLANTILLA_CONFIRMACION=
WHATSAPP_PLANTILLA_RECORDATORIO=
WHATSAPP_PLANTILLA_CANCELACION=
WHATSAPP_PLANTILLA_PROMOCION=
WHATSAPP_PAISES_OTP=57
OTP_PIMIENTA=
OTP_TOPE_DIARIO=500

# PostgreSQL (opcional; si está vacío se usa SQLite)
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Responsable del tratamiento de datos (OBLIGATORIO antes de producción) ---
RESP_RAZON_SOCIAL=
RESP_TIPO_ID=NIT
RESP_NUMERO_ID=
RESP_DOMICILIO=Armenia, Quindío
RESP_DIRECCION=Cra. 14 # 20-35, Armenia, Quindío
RESP_EMAIL_DATOS=
RESP_TELEFONO=+57 300 000 0000
RESP_AREA=Administración - Oficial de Protección de Datos
RESP_MATRICULA=
BARBERIA_HORARIO=Lunes a sábado de 9:00 a. m. a 8:00 p. m.

# Encargados (aparecen en la política)
ENCARGADO_HOSTING=
ENCARGADO_HOSTING_PAIS=
ENCARGADO_CORREO=
ENCARGADO_CORREO_PAIS=

# Producción
DJANGO_CSRF_TRUSTED_ORIGINS=https://tudominio.com
REDIS_URL=

# Correo para responder consultas y reclamos
